{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Verilog Simulation",
      "type": "shell",
      "command": "iverilog -o sim.vvp ${file} && vvp sim.vvp",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Open Waveform (GTKWave)",
      "type": "shell",
      "command": "gtkwave dump.vcd",
      "problemMatcher": []
    }
  ]
}